  id: {
    field: "id"
    name: "id"
  }

  name: "roadwork"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            params: [
              {
                example: "A1"
                kind: "param"
                name: "road_id"
                orig: "road_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/{roadId}/services/roadworks"
          rename: {
            param: {
              roadId: "road_id"
            }
          }
          segments: [
            {
              var: "road_id"
            }
            {
              lit: "services"
            }
            {
              lit: "roadworks"
            }
          ]
          select: {
            exist: [
              "road_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.roadworks`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "Uk9BRFdPUktTX19tZG0ubndfXzAyLTgwMDAwIEQgNzEgMTkgMDkvS0xCV1JO"
                kind: "param"
                name: "id"
                orig: "roadwork_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/details/roadworks/{roadworkId}"
          rename: {
            param: {
              roadworkId: "id"
            }
          }
          segments: [
            {
              lit: "details"
            }
            {
              lit: "roadworks"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
