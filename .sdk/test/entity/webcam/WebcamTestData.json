              "example": "A1",
              "pattern": "[A-Z][A-Za-z]*[1-9]([0-9]{1,3})?(\\/[A-Z][A-Za-z]*[1-9]([0-9]{1,3})?)?",
              "type": "string"
            }
          }
        ],
